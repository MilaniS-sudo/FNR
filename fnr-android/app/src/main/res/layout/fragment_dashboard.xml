<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">
        <TextView android:id="@+id/greeting" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="4dp" android:textAppearance="@style/FNR.Title" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_margin="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp">
                    <TextView android:id="@+id/statMinutes" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                        android:textColor="?attr/colorPrimary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Recorded this week" android:textAppearance="@style/FNR.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_margin="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp">
                    <TextView android:id="@+id/statNotes" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                        android:textColor="?attr/colorPrimary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Flash notes" android:textAppearance="@style/FNR.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_margin="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp">
                    <TextView android:id="@+id/statNeverPlayed" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                        android:textColor="?attr/colorPrimary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Not yet revised" android:textAppearance="@style/FNR.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/record"
            android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp"
            android:text="Record a study session" app:icon="@drawable/ic_mic" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/upload"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="8dp" android:text="Upload audio" app:icon="@drawable/ic_upload" />
            <com.google.android.material.button.MaterialButton android:id="@+id/recordings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Recordings" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Recent flash notes" android:textAppearance="@style/FNR.Section" />
            <com.google.android.material.button.MaterialButton android:id="@+id/allNotes"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="See all" />
        </LinearLayout>
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="16dp" android:visibility="gone"
            android:text="Your flash notes will appear here after you record a session and generate notes." />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recentList"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
