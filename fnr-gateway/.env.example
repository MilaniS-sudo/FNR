# Copy this file to .env and change the values. Never share or hand in your .env file.

# Must match FNR_APP_TOKEN in the Android project's local.properties
FNR_APP_TOKEN=change-me-demo-token

# Speech-to-text: local (free, runs on this computer) | openai (paid) | mock (no AI, for UI testing)
FNR_STT=local

# Key points: heuristic (free, rule based) | openai | gemini
FNR_SEGMENTER=heuristic

# Local Whisper model: tiny | base | small   (bigger = more accurate, slower)
FNR_WHISPER_MODEL=base

# Only needed if you switch a backend to openai or gemini
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_TEXT_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

FNR_MAX_UPLOAD_MB=25
FNR_RATE_LIMIT_PER_HOUR=20
